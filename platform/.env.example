COMPOSE_PROJECT_NAME=commerce-searchops-lab
POSTGRES_USER=searchops
POSTGRES_PASSWORD=searchops_local_only
POSTGRES_DB=searchops
DATABASE_URL=postgresql://searchops:searchops_local_only@postgres:5432/searchops
REDIS_URL=redis://redis:6379
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX_ALIAS=products-read
SEARCH_SERVICE_URL=http://search-service:8080
NEXT_PUBLIC_SEARCH_SERVICE_URL=http://localhost:8080
COMMERCE_SERVICE_URL=http://commerce:9000
NEXT_PUBLIC_COMMERCE_SERVICE_URL=http://localhost:9000

# ---------------------------------------------------------------------------
# AI 边界（可选增强，永远不是启动依赖；关掉只会退回纯 BM25）
# ---------------------------------------------------------------------------
AI_ADAPTER_URL=http://ai-adapter:8000

# 全局 kill switch。true = 开箱即用（默认的 mock provider 不需要任何密钥）。
# false 时 search-service 完全不调用适配器，响应里 ai_status=DISABLED、ai_applied=false。
# 三处默认值已对齐为 true：本文件、docker-compose.yml、search-service 的 application.yml。
AI_ENABLED=true

# 'mock' 或 'module.path:ClassName'（services/ai-adapter/app/provider.py 的 load_provider）。
# 换真实 provider 只改这一处：Java 侧不再校验 provider 名，只把它回报到响应的 ai_provider。
AI_PROVIDER=mock

# search-service 等待适配器返回改写结果的**读超时**（毫秒）。
# 为什么不是原来的 400：400ms 只够确定性的 mock provider。真实 LLM 的首字节延迟以秒计，
# 在 400ms 下每一次 AI 调用都会超时并降级成纯 BM25，而 HTTP 请求本身照样返回 200，
# 于是"真实 provider 一次都没跑成"会被误读成"AI 没效果"。现在降级原因会出现在响应的
# ai_status 字段（TIMEOUT / TRANSPORT_ERROR / INVALID_RESPONSE），但预算本身必须够用。
# 5000ms 是真实 provider 的可用下限；用更慢的模型（长 prompt、reasoning）可上调到
# 8000-10000。代价是适配器卡死时，每个开了 AI 的搜索请求最坏要等这么久才降级。
AI_TIMEOUT_MS=5000

# 建立到适配器的连接的超时（毫秒），与读超时分开计。适配器不可达时靠它快速失败，
# 而不是先耗掉整个 AI_TIMEOUT_MS 预算。
AI_CONNECT_TIMEOUT_MS=1000

# --- 真实 provider 预留变量（当前 mock provider 全部忽略）---------------------
# 纪律：这里只登记变量名，绝不写入任何真实密钥值。
# 真值只写在本地的 platform/.env（已被 platform/.gitignore 忽略）。
# 这些变量已显式加入 docker-compose.yml 的 ai-adapter.environment：该服务没有 env_file，
# platform/.env 仅用于 compose 的 ${VAR} 插值，不写进 environment 就进不了容器。
# 模型标识，例如 claude-sonnet-4-5 / gpt-4o-mini
AI_MODEL=
# 模型 API 凭据。留空即视为未配置，真实 provider 应在启动时明确报错而不是静默降级。
AI_API_KEY=
# 自建网关 / 代理 / 兼容端点的 base URL；留空表示使用 SDK 默认端点。
AI_API_BASE_URL=
# 采样温度。评测要可复现就保持 0。
AI_TEMPERATURE=0
# 单次改写调用的输出上限，避免超长响应吃掉 AI_TIMEOUT_MS 预算。
AI_MAX_TOKENS=512
# provider 自身对模型的调用超时（毫秒）。必须小于 AI_TIMEOUT_MS，否则 Java 侧先超时降级，
# 适配器却还在跑，白占一个连接。
AI_REQUEST_TIMEOUT_MS=4000

PRODUCT_LIMIT=20000
QUERY_LIMIT=10000
EVALUATION_QUERY_LIMIT=200
DATA_SAMPLE_SEED=searchops-lab-v1
ESCI_PRODUCTS_SHA256=25124442d064d64b26f74082d6fa09438d679efc0c183cf28d19064a2b65a265
ESCI_EXAMPLES_SHA256=4a735b693b4a424a6fc67f5be6e4c811495c488bbf66d02a602d308b2744263a
SEARCHOPS_APPROVAL_SECRET=local-demo-approval-secret
JWT_SECRET=local-demo-jwt-secret-change-me
COOKIE_SECRET=local-demo-cookie-secret-change-me
LOG_LEVEL=INFO
